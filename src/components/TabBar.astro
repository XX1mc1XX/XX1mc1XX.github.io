---
import { site } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;

function isActive(href: string) {
	return href === '/' ? path === '/' : path.startsWith(href);
}
---

<header class="tabbar">
	<button
		class="tabbar__toggle"
		type="button"
		id="activity-toggle"
		title="显示 / 收起左侧图标栏"
		aria-label="显示或收起左侧图标栏"
	>
		<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
			<path fill="none" stroke="currentColor" stroke-width="1.3" d="M2.2 3.2h11.6v9.6H2.2zM6.5 3.2v9.6" />
		</svg>
	</button>

	<a class="tabbar__brand" href="/">
		<span class="tabbar__dot"></span>
		<span>{site.name}</span>
	</a>

	{site.nav.map((item) => (
		<a class="tab" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
			{item.label}
		</a>
	))}

	<span class="tabbar__spacer"></span>
	<ThemeToggle />
</header>

<script is:inline>
	// 左边整条（图标栏 + 大纲）由这一个按钮统一收放。
	// 分成两个开关的话，点一下只收一半，剩下半条更难看
	document.addEventListener('DOMContentLoaded', () => {
		const toggle = document.getElementById('activity-toggle');
		if (!toggle) return;

		if (localStorage.getItem('activity-open') === '1') {
			document.documentElement.classList.remove('activity-hidden');
		}

		toggle.addEventListener('click', () => {
			const hidden = document.documentElement.classList.toggle('activity-hidden');
			document.documentElement.classList.toggle('sidebar-hidden', hidden);
			localStorage.setItem('activity-open', hidden ? '0' : '1');
			localStorage.setItem('sidebar-open', hidden ? '0' : '1');
		});
	});
</script>
