---
import { site } from '../site.config';

const path = Astro.url.pathname;

function isActive(href: string) {
	return href === '/' ? path === '/' : path.startsWith(href);
}

// 图标自己画，线条风格，跟 VS Code 活动栏一个视觉语言
const icons: Record<string, string> = {
	'/': 'M2.5 6.2 8 1.6l5.5 4.6V14a.6.6 0 0 1-.6.6h-3.2V9.8H6.3v4.8H3.1a.6.6 0 0 1-.6-.6V6.2Z',
	'/projects': 'M1.6 3.8a.9.9 0 0 1 .9-.9h3.2l1.2 1.6h6.6a.9.9 0 0 1 .9.9v6a.9.9 0 0 1-.9.9H2.5a.9.9 0 0 1-.9-.9V3.8Z',
	'/blog': 'M3.2 1.8h6.4l3.2 3.2v9.2H3.2V1.8Zm6 .9v2.8h2.8L9.2 2.7ZM5 7.6h6v1H5v-1Zm0 2.4h6v1H5v-1Z',
	'/tags': 'M2 3.2a1.2 1.2 0 0 1 1.2-1.2h4.3l6.3 6.3-5.5 5.5L2 7.5V3.2Zm2.6 1.3a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z',
	'/about': 'M8 1.6a3 3 0 1 1 0 6 3 3 0 0 1 0-6ZM2.4 14.4c0-2.7 2.5-4.4 5.6-4.4s5.6 1.7 5.6 4.4H2.4Z',
};
---

<nav class="activity" aria-label="主导航">
	<a class="activity__brand" href="/" title={site.name}>
		<span class="activity__dot"></span>
	</a>

	{site.nav.map((item) => (
		<a
			class={`activity__item${isActive(item.href) ? ' activity__item--active' : ''}`}
			href={item.href}
			title={item.label}
			aria-label={item.label}
			aria-current={isActive(item.href) ? 'page' : undefined}
		>
			<svg viewBox="0 0 16 16" width="19" height="19" aria-hidden="true">
				<path fill="currentColor" d={icons[item.href]} />
			</svg>
		</a>
	))}

	<div class="activity__spacer"></div>

	<button
		class="activity__item activity__item--btn"
		type="button"
		id="sidebar-toggle"
		title="收起 / 展开侧边栏"
		aria-label="收起或展开侧边栏"
	>
		<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
			<path
				fill="none"
				stroke="currentColor"
				stroke-width="1.3"
				d="M2.2 2.6h11.6v10.8H2.2zM5.8 2.6v10.8"
			/>
		</svg>
	</button>
</nav>

<script is:inline>
	// 侧边栏的开合记在本地，跟编辑器一致。
	// 这段要等 DOM 解析完再跑，否则拿不到活动栏底部那个按钮
	document.addEventListener('DOMContentLoaded', () => {
		const toggle = document.getElementById('sidebar-toggle');
		if (!toggle) return;

		// 首屏的开合状态由 BaseLayout 在服务端定好，这里只管响应点击
		toggle.addEventListener('click', () => {
			const hidden = document.documentElement.classList.toggle('sidebar-hidden');
			localStorage.setItem('sidebar-open', hidden ? '0' : '1');
		});

		// Ctrl / Cmd + B 开关侧边栏，跟编辑器一致
		document.addEventListener('keydown', (event) => {
			if (!(event.ctrlKey || event.metaKey) || event.key.toLowerCase() !== 'b') return;
			// 这一页压根没有侧边栏（按钮被藏了）就不拦键盘
			if (toggle.hasAttribute('hidden')) return;
			event.preventDefault();
			toggle.click();
		});
	});
</script>
