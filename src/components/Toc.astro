---
// 文章页和项目页共用的大纲。抽出来之前，这两页各有一份逐字相同的实现，
// 改一处忘一处的话，两边的折叠行为就不一样了
interface Heading {
	depth: number;
	text: string;
	slug: string;
}

interface TocNode {
	text: string;
	slug: string;
	children: { text: string; slug: string }[];
}

interface Props {
	headings: Heading[];
	backHref: string;
	backLabel: string;
}

const { headings, backHref, backLabel } = Astro.props;

// 折成两层树：二级标题当组，三级标题收在它下面。
// 全平铺的话，长文的大纲会变成一长条，没法折叠也看不出层次
const tocTree: TocNode[] = [];
for (const heading of headings.filter((item) => item.depth <= 3)) {
	if (heading.depth <= 2 || tocTree.length === 0) {
		tocTree.push({ text: heading.text, slug: heading.slug, children: [] });
	} else {
		tocTree[tocTree.length - 1].children.push({ text: heading.text, slug: heading.slug });
	}
}
---

<nav class="toc">
	<div class="toc__tools">
		<span class="toc__tools-label">大纲</span>
		<button
			type="button"
			class="toc__tool toc__tool--toggle"
			data-toc="toggle"
			title="全部展开 / 全部收起"
			aria-label="全部展开或全部收起"
		>
			<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
				<rect x="2.6" y="2.6" width="10.8" height="10.8" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.2" />
				<path d="M5.6 8h4.8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
				<path class="toc__tool-plus" d="M8 5.6v4.8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
			</svg>
		</button>
	</div>

	<ul class="toc__list">
		{tocTree.map((node) => (
			<li class="toc__group">
				<div class="toc__row">
					{node.children.length > 0 ? (
						<button type="button" class="toc__caret" aria-label="展开或收起">
							▾
						</button>
					) : (
						<span class="toc__caret toc__caret--blank" />
					)}
					<a href={`#${node.slug}`}>{node.text}</a>
				</div>
				{node.children.length > 0 && (
					<ul class="toc__children">
						{node.children.map((child) => (
							<li>
								<a href={`#${child.slug}`}>{child.text}</a>
							</li>
						))}
					</ul>
				)}
			</li>
		))}
	</ul>

	<a class="toc__back" href={backHref}>{backLabel}</a>
</nav>
