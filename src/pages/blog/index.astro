---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesGroup from '../../components/SeriesGroup.astro';
import { groupBySeries } from '../../utils/series';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const groups = groupBySeries(posts);
---

<BaseLayout title="文章" description="项目复盘与工程笔记">
	<h1 class="page-title">文章</h1>
	<p class="page-meta">项目复盘与工程笔记 · 共 {posts.length} 篇 · {groups.length} 个系列</p>

	{
		groups.length > 0 ? (
			<div class="series-list">
				{groups.map((g) => (
					<SeriesGroup
						name={g.name}
						tagline={g.tagline}
						project={g.project}
						posts={g.posts}
					/>
				))}
			</div>
		) : (
			<p class="empty">还没有文章。把 Markdown 放进 src/content/posts/ 就会出现。</p>
		)
	}
</BaseLayout>
