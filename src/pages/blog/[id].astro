---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('posts', ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, tags } = post.data;

const toc = headings.filter((heading) => heading.depth <= 3);

// 把扁平的大纲折成两层树：二级标题当组，三级标题收在它下面。
// 全部平铺的话，长文的大纲会变成一长条，没法折叠也没法一眼看出层次
type TocNode = { text: string; slug: string; children: { text: string; slug: string }[] };
const tocTree: TocNode[] = [];
for (const heading of toc) {
	if (heading.depth <= 2 || tocTree.length === 0) {
		tocTree.push({ text: heading.text, slug: heading.slug, children: [] });
	} else {
		tocTree[tocTree.length - 1].children.push({ text: heading.text, slug: heading.slug });
	}
}

const all = (await getCollection('posts', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const position = all.findIndex((item) => item.id === post.id);
const newer = position > 0 ? all[position - 1] : undefined;
const older = position < all.length - 1 ? all[position + 1] : undefined;
---

<BaseLayout title={title} description={description} wide>
	<nav slot="sidebar" class="toc">
		<div class="toc__tools">
			<span class="toc__tools-label">大纲</span>
			<button type="button" class="toc__tool" data-toc="expand" title="全部展开">全部展开</button>
			<button type="button" class="toc__tool" data-toc="collapse" title="全部收起">全部收起</button>
		</div>
		<ul class="toc__list">
			{tocTree.map((node) => (
				<li class="toc__group">
					<div class="toc__row">
						{node.children.length > 0 ? (
							<button type="button" class="toc__caret" aria-label="展开或收起">
								▾
							</button>
						) : (
							<span class="toc__caret toc__caret--blank" />
						)}
						<a href={`#${node.slug}`}>{node.text}</a>
					</div>
					{node.children.length > 0 && (
						<ul class="toc__children">
							{node.children.map((child) => (
								<li>
									<a href={`#${child.slug}`}>{child.text}</a>
								</li>
							))}
						</ul>
					)}
				</li>
			))}
		</ul>
		<a class="toc__back" href="/blog/">← 全部文章</a>
	</nav>

	<article class="prose">
		<header>
			<h1>{title}</h1>
			{tags.length > 0 && <p class="page-meta">{tags.join(' · ')}</p>}
		</header>
		<Content />
	</article>

	{(newer || older) && (
		<nav class="post-nav">
			{older && (
				<a class="post-nav__item" href={`/blog/${older.id}/`}>
					<span class="post-nav__label">← 上一篇</span>
					<span class="post-nav__title">{older.data.title}</span>
				</a>
			)}
			{newer && (
				<a class="post-nav__item post-nav__item--next" href={`/blog/${newer.id}/`}>
					<span class="post-nav__label">下一篇 →</span>
					<span class="post-nav__title">{newer.data.title}</span>
				</a>
			)}
		</nav>
	)}

	<a class="backlink" href="/blog/">← 返回文章列表</a>
</BaseLayout>
