---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import { site } from '../site.config';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout>
	<section class="hero">
		<h1 class="hero__name">{site.author}</h1>
		<p class="hero__tagline">{site.tagline}</p>
		<div class="hero__links">
			{site.resume && <a class="hero__link" href={site.resume}>简历 PDF</a>}
			<a class="hero__link" href={site.github}>GitHub</a>
			<a class="hero__link" href={`mailto:${site.email}`}>{site.email}</a>
		</div>
	</section>

	<h2 class="section-title">项目</h2>
	{projects.length > 0 ? (
		<div class="cards">
			{projects.map((project) => <ProjectCard project={project} />)}
		</div>
	) : (
		<p class="empty">还没有项目。把 Markdown 放进 src/content/projects/ 就会出现。</p>
	)}

	<h2 class="section-title">技能</h2>
	<div class="skills">
		{site.skills.map((row) => (
			<div class="skills__row">
				<span class="skills__group">{row.group}</span>
				<div class="card__tags">
					{row.items.map((item) => <span class="tag">{item}</span>)}
				</div>
			</div>
		))}
	</div>

	<h2 class="section-title">文章</h2>
	{posts.length > 0 ? (
		<div class="cards">
			{posts.slice(0, 3).map((post) => <PostCard post={post} />)}
		</div>
	) : (
		<p class="empty">还没有文章。把 Markdown 放进 src/content/posts/ 就会出现。</p>
	)}
</BaseLayout>
