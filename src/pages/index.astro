---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SeriesGroup from '../components/SeriesGroup.astro';
import { site } from '../site.config';
import { groupBySeries } from '../utils/series';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const groups = groupBySeries(posts);
// 首页每组只展开三篇，其余走「还有 N 篇」进 /blog——首页是概览，不是目录
const HOME_LIMIT = 3;
---

<BaseLayout>
	<section class="hero">
		<h1 class="hero__name">{site.author}</h1>
		<p class="hero__tagline">{site.tagline}</p>
		<div class="hero__links">
			{site.resume && <a class="hero__link" href={site.resume}>简历 PDF</a>}
			<a class="hero__link" href={site.github}>GitHub</a>
			<a class="hero__link" href={`mailto:${site.email}`}>{site.email}</a>
		</div>
	</section>

	<h2 class="section-title">项目</h2>
	{projects.length > 0 ? (
		<div class="cards">
			{projects.map((project) => <ProjectCard project={project} />)}
		</div>
	) : (
		<p class="empty">还没有项目。把 Markdown 放进 src/content/projects/ 就会出现。</p>
	)}

	<h2 class="section-title">技能</h2>
	<div class="skills">
		{site.skills.map((row) => (
			<div class="skills__row">
				<span class="skills__group">{row.group}</span>
				<div class="card__tags">
					{row.items.map((item) => <span class="tag">{item}</span>)}
				</div>
			</div>
		))}
	</div>

	<h2 class="section-title">文章</h2>
	{
		groups.length > 0 ? (
			<div class="series-list">
				{groups.map((g) => (
					<SeriesGroup
						name={g.name}
						tagline={g.tagline}
						project={g.project}
						posts={g.posts}
						limit={HOME_LIMIT}
					/>
				))}
				<a class="more-link" href="/blog/">
					全部 {posts.length} 篇 →
				</a>
			</div>
		) : (
			<p class="empty">还没有文章。把 Markdown 放进 src/content/posts/ 就会出现。</p>
		)
	}
</BaseLayout>
