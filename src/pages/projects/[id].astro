---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const { title, summary, role, period, stack, repo } = project.data;

const toc = headings.filter((heading) => heading.depth <= 3);

// 折成两层树：二级标题当组，三级标题收在下面。
// 全平铺的话长页大纲会变成一长条，折叠不了也看不出层次
type TocNode = { text: string; slug: string; children: { text: string; slug: string }[] };
const tocTree: TocNode[] = [];
for (const heading of toc) {
	if (heading.depth <= 2 || tocTree.length === 0) {
		tocTree.push({ text: heading.text, slug: heading.slug, children: [] });
	} else {
		tocTree[tocTree.length - 1].children.push({ text: heading.text, slug: heading.slug });
	}
}
---

<BaseLayout title={title} description={summary} wide>
	<nav slot="sidebar" class="toc">
		<div class="toc__tools">
			<span class="toc__tools-label">大纲</span>
			<button type="button" class="toc__tool" data-toc="expand" title="全部展开">全部展开</button>
			<button type="button" class="toc__tool" data-toc="collapse" title="全部收起">全部收起</button>
		</div>
		<ul class="toc__list">
			{tocTree.map((node) => (
				<li class="toc__group">
					<div class="toc__row">
						{node.children.length > 0 ? (
							<button type="button" class="toc__caret" aria-label="展开或收起">
								▾
							</button>
						) : (
							<span class="toc__caret toc__caret--blank" />
						)}
						<a href={`#${node.slug}`}>{node.text}</a>
					</div>
					{node.children.length > 0 && (
						<ul class="toc__children">
							{node.children.map((child) => (
								<li>
									<a href={`#${child.slug}`}>{child.text}</a>
								</li>
							))}
						</ul>
					)}
				</li>
			))}
		</ul>
		<a class="toc__back" href="/projects/">← 全部项目</a>
	</nav>

	<article class="prose">
		<header>
			<h1>{title}</h1>
			<p class="page-meta">{[role, period].filter(Boolean).join(' · ')}</p>
			<p>{summary}</p>

			{stack.length > 0 && (
				<div class="card__tags">
					{stack.map((item) => <span class="tag">{item}</span>)}
				</div>
			)}

			{repo && (
				<p>
					源码：<a href={repo}>{repo}</a>
				</p>
			)}
		</header>
		<Content />
	</article>

	<a class="backlink" href="/projects/">← 返回项目列表</a>
</BaseLayout>
