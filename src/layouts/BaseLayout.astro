---
import '../styles/global.css';
import '../styles/parts.css';
import '../styles/agent.css';
import TabBar from '../components/TabBar.astro';
import StatusBar from '../components/StatusBar.astro';
import ActivityBar from '../components/ActivityBar.astro';
import SideBar from '../components/SideBar.astro';
import ReadingTools from '../components/ReadingTools.astro';
import AgentDrawer from '../components/agent/AgentDrawer';
import { site } from '../site.config';

interface Props {
	title?: string;
	description?: string;
	// 正文带侧边栏（目录）的页面用更宽的内容区
	wide?: boolean;
}

const { title, description = site.tagline, wide = false } = Astro.props;

// 只有传了 sidebar 槽位的页面（文章、项目）才出左栏。
// 在服务端就定下来，浏览器不会先画出一根空条再收掉
const hasSidebar = Astro.slots.has('sidebar');
---

<!doctype html>
<html lang="zh-CN" class={`activity-hidden${hasSidebar ? '' : ' sidebar-hidden'}`}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
		<title>{title ? `${title} · ${site.name}` : site.name}</title>
		<script is:inline>
			// 这几件都要在首屏渲染前定好，否则会先闪一下再变
			document.documentElement.dataset.theme = localStorage.getItem('theme') || 'dark';
			// 标记「JS 可用」。文章系列的折叠靠它生效：没有 JS 时列表得全部可见，
			// 所以默认不收，等这个类加上去才折叠——反过来做会先闪出全部再收起来
			document.documentElement.classList.add('js');
			// 用户手动收起过侧边栏就一直收起；切页时左右两栏不会忽有忽无
			if (localStorage.getItem('sidebar-open') === '0') {
				document.documentElement.classList.add('sidebar-hidden');
			}

			const openAgent = () => {
				// 宽度要自己补 px，存的是个纯数字
				const w = Number(localStorage.getItem('agent-width')) || 460;
				document.documentElement.style.setProperty('--agent-w', w + 'px');
				document.documentElement.classList.add('agent-open');
			};
			// 上次开着助手就继续开着
			if (localStorage.getItem('agent-open') === '1') openAgent();

			// 助手岛用 client:idle，要等浏览器空闲才水合，这期间点浮标是没人接的。
			// 兜底：把状态写进本地存储再手动加类——等岛水合时它读到的就是
			// 「已经打开」，state 和这里一致，不会反手把面板又关上
			document.addEventListener('click', (event) => {
				if (!event.target.closest || !event.target.closest('.agent-fab')) return;
				try {
					localStorage.setItem('agent-open', '1');
				} catch {
					// 存不进去也无妨，这次照样打开，只是下次进来不会自动开着
				}
				openAgent();
			}, true);
		</script>
	</head>
	<body>
		<TabBar />

		<div class="workspace">
			<ActivityBar />
			<SideBar>
				<slot name="sidebar" />
			</SideBar>

			<main class={wide ? 'content content--wide' : 'content'}>
				<div class="content__inner">
					<slot />
				</div>
			</main>

			<!-- client:idle 而不是 client:load：助手那一坨（marked + dompurify + preact）
			     是 43KB gzip，70 个页面每个都带。访客里真正会点开助手的不到一成，
			     不值得让它去跟首屏抢带宽。面板的显隐本来就由 CSS 的 agent-open 类控制，
			     水合晚一点只会看到空框，不会有布局跳动。
			     timeout 是上限——不给的话 requestIdleCallback 会一直等到浏览器
			     真正空闲，页面忙的时候可能等很久；这期间点击由 head 里那段兜底接住 -->
			<AgentDrawer client:idle={{ timeout: 1500 }} />
		</div>

		<StatusBar />
		<ReadingTools />
	</body>
</html>
