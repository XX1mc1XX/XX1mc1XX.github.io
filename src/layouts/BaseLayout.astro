---
import '../styles/global.css';
import '../styles/parts.css';
import '../styles/agent.css';
import TabBar from '../components/TabBar.astro';
import StatusBar from '../components/StatusBar.astro';
import ActivityBar from '../components/ActivityBar.astro';
import SideBar from '../components/SideBar.astro';
import ReadingTools from '../components/ReadingTools.astro';
import AgentDrawer from '../components/agent/AgentDrawer';
import { collectArticles } from '../lib/articles';
import { site } from '../site.config';

interface Props {
	title?: string;
	description?: string;
	// 正文带侧边栏（目录）的页面用更宽的内容区
	wide?: boolean;
}

const { title, description = site.tagline, wide = false } = Astro.props;

// 只有传了 sidebar 槽位的页面（文章、项目）才出左栏。
// 在服务端就定下来，浏览器不会先画出一根空条再收掉
const hasSidebar = Astro.slots.has('sidebar');

// 构建时把全部文章一起交给助手，它才能在浏览器里检索并回答
const articles = await collectArticles();
---

<!doctype html>
<html lang="zh-CN" class={`activity-hidden${hasSidebar ? '' : ' sidebar-hidden'}`}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
		<title>{title ? `${title} · ${site.name}` : site.name}</title>
		<script is:inline>
			// 这两件都要在首屏渲染前定好，否则会先闪一下再变
			document.documentElement.dataset.theme = localStorage.getItem('theme') || 'dark';
			// 用户手动收起过侧边栏就一直收起；切页时左右两栏不会忽有忽无
			if (localStorage.getItem('sidebar-open') === '0') {
				document.documentElement.classList.add('sidebar-hidden');
			}
			// 上次开着助手就继续开着。宽度要自己补 px，存的是个纯数字
			if (localStorage.getItem('agent-open') === '1') {
				const w = Number(localStorage.getItem('agent-width')) || 460;
				document.documentElement.style.setProperty('--agent-w', w + 'px');
				document.documentElement.classList.add('agent-open');
			}
		</script>
	</head>
	<body>
		<TabBar />

		<div class="workspace">
			<ActivityBar />
			<SideBar>
				<slot name="sidebar" />
			</SideBar>

			<main class={wide ? 'content content--wide' : 'content'}>
				<div class="content__inner">
					<slot />
				</div>
			</main>

			<AgentDrawer articles={articles} client:load />
		</div>

		<StatusBar />
		<ReadingTools />
	</body>
</html>
